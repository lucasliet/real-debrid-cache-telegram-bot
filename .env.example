# Token do bot, emitido pelo @BotFather
BOT_TOKEN=
# Token privado da API do Real-Debrid (https://real-debrid.com/apitoken)
RD_TOKEN=
# Seu ID numérico do Telegram; só este usuário pode usar o bot
ALLOWED_USER_ID=

# Opcionais
# URL pública do webhook: use a mesma do wrangler.jsonc. Sem ela, encerrar `npm run dev` ou rodar
# `npm run webhook` registra o webhook no endereço padrão do projeto, não no seu Worker
# SERVER_URL=https://real-debrid-cache-bot.<sua-conta>.workers.dev/webhook
# Credenciais "usuario:senha" da loja Tinfoil; sem elas /update_tinfoil fica desativado
# TINFOIL_USER_PASS=
# TINFOIL_UPDATE_URL=https://foil.lucasliet.com.br/update
# Modelo de decisão do Workers AI usado nas sugestões de busca (só tem efeito no Worker)
# AI_SEARCH_MODEL=@cf/cloudflare/clef
# Probabilidade mínima para um item ser sugerido (0 a 1)
# AI_SEARCH_MIN_PROBABILITY=0.5
