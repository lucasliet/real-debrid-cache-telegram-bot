{
	"tasks": {
		"dev": "deno run --watch --allow-net --allow-read --allow-env --allow-import --env-file=.env src/main.ts",
		"build": "deno bundle --allow-import --platform=browser -o dist/worker.js worker.ts",
		"dev:worker": "npx --yes wrangler@4.143.1 dev",
		"deploy": "npx --yes wrangler@4.143.1 deploy"
	},
	"imports": {
		"grammy": "https://deno.land/x/grammy@v1.21.1/mod.ts",
		"grammy-types": "https://deno.land/x/grammy@v1.21.1/types.ts",
		"hono": "jsr:@hono/hono@^4",
		"hono/cors": "jsr:@hono/hono@^4/cors",
		"@/": "./src/"
	},
	"compilerOptions": {
		"strict": true
	},
	"lint": {
		"include": ["*.ts"],
		"exclude": ["README.md", ".env", "dist", ".wrangler"]
	},
	"fmt": {
		"files": {
			"include": ["src/"]
		},
		"exclude": ["README.md", ".env"],
		"lineWidth": 160,
		"useTabs": true,
		"semiColons": true,
		"singleQuote": true
	}
}
