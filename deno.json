{
	"tasks": {
		"dev": "deno run --watch --allow-net --allow-read --allow-env --env-file=.env src/main.ts",
		"build": "deno bundle --platform=browser -o dist/worker.js worker.ts",
		"dev:worker": "npx --yes wrangler@4.143.1 dev",
		"deploy": "npx --yes wrangler@4.143.1 deploy",
		"check": "deno check worker.ts src/main.ts tests/",
		"test": "deno test --allow-env",
		"verify": "deno fmt --check && deno lint && deno task check && deno task test"
	},
	"imports": {
		"grammy": "npm:grammy@^1.48.0",
		"hono": "jsr:@hono/hono@^4.13.22",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@/": "./src/"
	},
	"nodeModulesDir": "none",
	"compilerOptions": {
		"strict": true
	},
	"lint": {
		"include": ["src/", "tests/", "worker.ts"]
	},
	"fmt": {
		"include": ["src/", "tests/", "worker.ts"],
		"lineWidth": 160,
		"useTabs": true,
		"semiColons": true,
		"singleQuote": true
	}
}
