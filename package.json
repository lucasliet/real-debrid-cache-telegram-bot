{
	"name": "real-debrid-cache-telegram-bot",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx --env-file=.env src/main.ts",
		"dev:worker": "wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"build": "wrangler deploy --dry-run --outdir dist",
		"format": "biome check --write",
		"lint": "biome check",
		"typecheck": "wrangler types && tsc --noEmit",
		"test": "vitest run",
		"verify": "npm run lint && npm run typecheck && npm test && npm run build",
		"webhook": "tsx --env-file=.env scripts/register-webhook.ts"
	},
	"dependencies": {
		"@grammyjs/auto-retry": "^2.0.2",
		"grammy": "^1.48.0",
		"hono": "^4.13.23"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@cloudflare/vitest-plugin": "^1.9.2",
		"@types/node": "^22",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.2",
		"wrangler": "^4.168.0"
	}
}
