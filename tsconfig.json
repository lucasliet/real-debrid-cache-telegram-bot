{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types", "node"],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src", "tests", "vitest.config.ts", "worker-configuration.d.ts"]
}
